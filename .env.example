# Postgres connection string for your Supabase-hosted database.
#
# Get it from the Supabase dashboard: Connect -> Connection string.
# Use a "Session pooler" or "Transaction pooler" string (host ends in
# .pooler.supabase.com). The "Direct connection" (host db.<ref>.supabase.co)
# is IPv6-only and will not work from IPv4-only networks such as GitHub
# Codespaces.
#
# Session pooler (port 5432) is fine for migrations, the seed, and the app.
# Switch the app to the transaction pooler (port 6543) if you later deploy to
# a serverless runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret for signing staff AND manager session JWTs (HS256). Must be at least
# 16 characters; use something long and random, e.g. `openssl rand -base64 48`.
SESSION_SECRET="replace-with-a-long-random-string"

# Supabase project — used for manager authentication (email + password via
# Supabase Auth / GoTrue). Dashboard: Project Settings -> API. The publishable
# ("anon") key is safe to expose; it only permits the password-grant call.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
